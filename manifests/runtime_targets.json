{
  "schema_version": 1,
  "status": "active",
  "last_updated": "2026-09-19",
  "default_target": "codex-home",
  "supported_runtime_kinds": [
    "codex",
    "claude-code",
    "opencode"
  ],
  "rules": {
    "targets_must_be_declared": true,
    "live_writes_must_use_declared_apply_chain": true,
    "llm_agent_must_not_write_live_root": true,
    "reference_subrepos_must_not_be_runtime_targets": true,
    "future_targets_require_source_and_live_chain": true
  },
  "targets": [
    {
      "id": "codex-home",
      "runtime": "codex",
      "role": "external-handoff-target",
      "enabled": true,
      "source_repo": "~/codex",
      "live_root": "~/.codex",
      "registry_repo": "codex",
      "source_to_live_chain": [
        "agent-dev-kit",
        "~/codex",
        "~/.codex"
      ],
      "health_adapter": "codex-global-health",
      "footprint_check": "scripts/check-runtime-live-footprint.sh",
      "target_policy_check": "scripts/check-global-codex-target-policy.sh",
      "runtime_footprint": {
        "required_skills": [
          "adk-runtime-router",
          "adk-requirements-triage",
          "adk-task-breakdown",
          "adk-test-strategy",
          "adk-systematic-debugging",
          "adk-code-review-loop",
          "adk-commit-pr-quality-gate",
          "adk-verification-before-completion",
          "adk-parallel-agent-governance",
          "adk-worktree-governance",
          "adk-branch-closeout"
        ],
        "forbidden_skills": [
          "brainstorming",
          "dispatching-parallel-agents",
          "executing-plans",
          "finishing-a-development-branch",
          "receiving-code-review",
          "requesting-code-review",
          "subagent-driven-development",
          "systematic-debugging",
          "test-driven-development",
          "using-git-worktrees",
          "using-superpowers",
          "verification-before-completion",
          "writing-plans",
          "writing-skills"
        ],
        "forbidden_paths": [
          "vendor/plugins/superpowers"
        ]
      },
      "required_evidence": [
        "~/codex build",
        "~/codex doctor",
        "~/codex apply plan",
        "~/codex apply dry-run",
        "rollback evidence",
        "global runtime health",
        "runtime live footprint"
      ],
      "write_policy": "report-only-from-llm_agent",
      "notes": "Codex is the currently declared external runtime target. Claude Code and OpenCode remain supported runtime kinds but require their own source/live chains before becoming active targets."
    },
    {
      "id": "claude-code-home",
      "runtime": "claude-code",
      "role": "target-candidate",
      "enabled": false,
      "source_repo": null,
      "live_root": null,
      "registry_repo": null,
      "source_to_live_chain": [],
      "health_adapter": null,
      "footprint_check": null,
      "target_policy_check": null,
      "required_evidence": [
        "declared source repo",
        "declared live root",
        "read-only health adapter",
        "dry-run apply evidence",
        "rollback evidence"
      ],
      "write_policy": "not-enabled",
      "activation_requirements": [
        "declare source_repo and live_root",
        "add read-only health adapter",
        "add source-to-live apply and rollback evidence",
        "pass runtime target gate with enabled=true"
      ],
      "notes": "Candidate template only. It must not be treated as an active target until source/live governance exists."
    },
    {
      "id": "opencode-home",
      "runtime": "opencode",
      "role": "target-candidate",
      "enabled": false,
      "source_repo": null,
      "live_root": null,
      "registry_repo": null,
      "source_to_live_chain": [],
      "health_adapter": null,
      "footprint_check": null,
      "target_policy_check": null,
      "required_evidence": [
        "declared source repo",
        "declared live root",
        "read-only health adapter",
        "dry-run apply evidence",
        "rollback evidence"
      ],
      "write_policy": "not-enabled",
      "activation_requirements": [
        "declare source_repo and live_root",
        "add read-only health adapter",
        "add source-to-live apply and rollback evidence",
        "pass runtime target gate with enabled=true"
      ],
      "notes": "Candidate template only. It must not be treated as an active target until source/live governance exists."
    }
  ],
  "health_adapter_rules": {
    "targets_must_reference_adapter_id": true,
    "enabled_adapters_must_be_read_only": true,
    "enabled_adapters_must_have_executable_script": true,
    "disabled_adapters_must_not_dispatch": true,
    "adapter_runtime_must_match_target_runtime": true
  },
  "health_adapters": [
    {
      "id": "codex-global-health",
      "runtime": "codex",
      "status": "active",
      "enabled": true,
      "script": "scripts/check-global-codex-health.sh",
      "target_ids": [
        "codex-home"
      ],
      "profiles": [
        "minimal",
        "security",
        "strict"
      ],
      "read_only": true,
      "input_contract": {
        "argv": [
          "live_root",
          "profile"
        ],
        "live_root_source": "runtime_targets.json target.live_root",
        "profile_source": "check-runtime-health.sh --profile"
      },
      "output_contract": {
        "exit_0": "health pass",
        "nonzero": "health fail",
        "summary_json_wrapped_by": "scripts/check-runtime-health.sh"
      },
      "notes": "Codex is the only active runtime health adapter. The adapter is read-only and must not apply assets."
    },
    {
      "id": "claude-code-health",
      "runtime": "claude-code",
      "status": "candidate",
      "enabled": false,
      "script": null,
      "target_ids": [],
      "profiles": [],
      "read_only": true,
      "activation_requirements": [
        "declare active runtime target",
        "add executable read-only health script",
        "bind target.health_adapter to this adapter id",
        "add source-to-live apply and rollback evidence",
        "pass disabled target negative gate before activation"
      ],
      "notes": "Candidate placeholder only. It must not dispatch until a governed source/live chain exists."
    },
    {
      "id": "opencode-health",
      "runtime": "opencode",
      "status": "candidate",
      "enabled": false,
      "script": null,
      "target_ids": [],
      "profiles": [],
      "read_only": true,
      "activation_requirements": [
        "declare active runtime target",
        "add executable read-only health script",
        "bind target.health_adapter to this adapter id",
        "add source-to-live apply and rollback evidence",
        "pass disabled target negative gate before activation"
      ],
      "notes": "Candidate placeholder only. It must not dispatch until a governed source/live chain exists."
    }
  ]
}
