{
  "schema": "reference-repository-removal-policy/v1",
  "status": "gated-removal",
  "last_updated": "2026-07-19",
  "default_mode": "dry-run",
  "required_gates": [
    "lifecycle_state_gate",
    "protected_repo_gate",
    "active_core_gate",
    "adoption_decision_gate",
    "evidence_dependency_gate",
    "dirty_baseline_gate",
    "rollback_plan_gate",
    "precheck_gate",
    "postcheck_gate"
  ],
  "eligible_lifecycle_states": [
    "archive-only",
    "disabled"
  ],
  "protected_repositories": [
    "agent-dev-kit"
  ],
  "blocked_lifecycle_states": [
    "active-core",
    "active-reference",
    "watch"
  ],
  "allowed_apply_targets": [
    ".gitmodules",
    "subrepos/registry.csv",
    "subrepos/dirty-baseline.tsv",
    "manifests/subrepo_lifecycle.json",
    "docs/llm-agent-maintenance-guide.md",
    "docs/runbooks/reference-repository-lifecycle.md",
    "reports/reference-repository-removal-*.json",
    "reports/reference-repository-removal-*.md"
  ],
  "rules": {
    "plan_requires_hashed_artifacts": true,
    "default_must_be_dry_run": true,
    "apply_requires_explicit_flag": true,
    "apply_requires_confirmed_plan": true,
    "apply_must_not_touch_agent_dev_kit": true,
    "apply_must_not_delete_without_rollback": true,
    "apply_must_run_precheck_and_postcheck": true,
    "dirty_baseline_update_must_be_explicit": true
  }
}
