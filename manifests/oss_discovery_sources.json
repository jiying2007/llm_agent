{
  "schema_version": 1,
  "status": "report-only",
  "last_updated": "2026-06-16",
  "candidate_output_pattern": "reports/oss-discovery-candidates-YYYY-MM-DD.jsonl",
  "rules": {
    "discovery_must_not_clone": true,
    "discovery_must_not_register": true,
    "discovery_must_not_absorb": true,
    "discovery_must_not_execute_external_code": true
  },
  "sources": [
    {
      "id": "github-search",
      "type": "github-search",
      "enabled": true,
      "mode": "metadata-only",
      "query_classes": [
        "workflow-core",
        "agent-ecosystem",
        "tooling",
        "knowledge",
        "runtime-policy"
      ],
      "freshness_days": 90
    },
    {
      "id": "github-graphql",
      "type": "github-graphql",
      "enabled": false,
      "mode": "metadata-only",
      "query_classes": [
        "structured-repository-metadata"
      ],
      "freshness_days": 90
    },
    {
      "id": "openssf-scorecard",
      "type": "security-metadata",
      "enabled": false,
      "mode": "metadata-only",
      "query_classes": [
        "security-and-maintenance-signals"
      ],
      "freshness_days": 30
    },
    {
      "id": "user-provided-url",
      "type": "manual-input",
      "enabled": true,
      "mode": "ledger-only",
      "query_classes": [
        "user-url",
        "local-path"
      ],
      "freshness_days": 0
    },
    {
      "id": "local-reports",
      "type": "local-evidence",
      "enabled": true,
      "mode": "ledger-only",
      "query_classes": [
        "reports",
        "article-ledgers",
        "weekly-diff-scans"
      ],
      "freshness_days": 30
    }
  ]
}
