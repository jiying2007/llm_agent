{
  "schema": "llm-agent-long-term-asset-rehearsal-policy/v1",
  "enabled": true,
  "terminal_effect": "none",
  "purpose": "Exercise the LTA-02 R2 and LTA-04 >=30-day PASS paths with isolated fixtures without creating terminal qualification evidence.",
  "required_markers": {
    "simulated": true,
    "terminal_qualified": false
  },
  "scopes": {
    "r2": {
      "mode": "synthetic-r2-fixture",
      "test": "tests/test_runtime_portability_certifier.sh",
      "claim": "R2 certifier PASS path is reachable with isolated synthetic comparison evidence only."
    },
    "longitudinal": {
      "mode": "time-travel-30-day-fixture",
      "test": "tests/test_longitudinal_operation_certifier.sh",
      "claim": "LTA-04 >=30-day certifier PASS path is reachable with isolated time-travel fixture evidence only."
    }
  },
  "forbidden_canonical_outputs": [
    "reports/long-term-assets/runtime-portability-current.json",
    "reports/long-term-assets/longitudinal-operation-current.json",
    "manifests/long_term_asset_qualification.json"
  ],
  "hard_rules": {
    "rehearsal_must_not_change_real_lta_status": true,
    "rehearsal_must_not_write_canonical_evidence": true,
    "rehearsal_must_leave_worktree_unchanged": true,
    "rehearsal_pass_is_not_terminal_pass": true,
    "real_r2_still_requires_real_provider_execution": true,
    "real_lta04_still_requires_real_calendar_window": true
  }
}
