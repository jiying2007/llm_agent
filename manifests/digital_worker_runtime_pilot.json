{
  "schema_version": 1,
  "contract_version": "1.0",
  "status": "report-only",
  "purpose": "Joint runtime comparison contract for digital-worker, agent-dev-kit and llm_agent without changing verification semantics.",
  "roles": {
    "digital-worker": ["work_item", "system_context", "acceptance", "action_policy", "engineering_result", "verification", "independent_review"],
    "agent-dev-kit": ["profile", "skill_assets", "asset_bundle_identity", "target_export_and_install_contract"],
    "llm_agent": ["runtime_target_health", "runtime_comparison_evidence", "loop_readiness_mapping", "adoption_recommendation"]
  },
  "frozen_inputs": [
    "work_item_id",
    "task_type",
    "workflow_mode",
    "repo_root",
    "exact_base_commit",
    "dirty_baseline",
    "material_manifest",
    "knowledge_context_fingerprint",
    "engineering_task_package",
    "acceptance_criteria",
    "required_verification"
  ],
  "isolation": {
    "share_previous_runtime_final_answer": false,
    "share_previous_runtime_patch": false,
    "shared_pre_run_context_only": true
  },
  "loop_readiness_mapping": {
    "tool_execution_evidence": "digital-worker:evidence-bundle",
    "loop_recovery_evidence": "digital-worker:team-run-state.blockers/recovery",
    "guardrail_coverage": "digital-worker:A0-A7+gate-policy",
    "budget_control_evidence": "digital-worker:context-and-action-scope",
    "handoff_or_delegation_evidence": "digital-worker:engineering-handoff+delivery-receipt",
    "termination_evidence": "digital-worker:completed/blocked/review-gate"
  },
  "candidate_runtime_targets": ["codex-home", "claude-code"],
  "required_metrics": [
    "contract_adherence",
    "correctness",
    "build_test_success",
    "evidence_completeness",
    "unsupported_claims",
    "human_corrections",
    "verification_completeness",
    "incorrect_pass",
    "recovery_behavior",
    "runtime_identity_traceability",
    "latency",
    "cost",
    "context_rebuild"
  ],
  "hard_rules": {
    "runtime_output_is_not_verification_pass": true,
    "same_verifier_and_reviewer_standard": true,
    "a0_a7_unchanged_by_runtime": true,
    "a6_a7_human_gate": true,
    "missing_runtime_health_is_blocked_not_pass": true
  },
  "completion": "at least two healthy runtimes complete the same controlled real task with independent verification and review"
}
