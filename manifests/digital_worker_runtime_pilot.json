    "runtime_profile_owner": "runtime-binding",
    "asset_profile_must_not_equal_runtime_profile_by_semantic_assumption": true
  },
  "asset_identity_semantics": {
    "provider_release_is_immutable": true,
    "runtime_binding_selects_exact_source_set": true,
    "runtime_binding_assembles_runtime_distribution": true,
    "monolithic_runtime_bundle_is_not_required_identity": true,
    "source_of_truth_stays_at_source": true
  },
  "replaceability_evidence_levels": {
    "R1-binding-conformance": "Controlled/fake adapters may prove contract shape, exact identity handling, failure semantics and rollback only; R1 never qualifies terminal portability.",
    "R2-real-provider-substitution": "Two real Runtime/Provider Bindings execute the same frozen real task in their own execution domains, emit independently attested execution receipts, and are evaluated under shared Digital Worker verification/review semantics; R2 is required for terminal portability."
  },
  "terminal_replaceability_evidence_level": "R2-real-provider-substitution",
  "isolation": {
    "share_previous_runtime_final_answer": false,
    "share_previous_runtime_patch": false,
    "shared_pre_run_context_only": true
  },
  "execution_ownership": {
    "model": "runtime-owned-provider-execution+digital-worker-verifier-only",
    "provider_credentials_owner": "runtime-binding-repository",
    "provider_execution_authority_owner": "runtime-binding-repository",
    "digital_worker_holds_provider_credentials": false,
    "runtime_execution_evidence_transport": "github-oidc-attested-runtime-owned-evidence",
    "digital_worker_verifies_execution_provenance": true,
    "digital_worker_projects_native_receipts": true,
    "digital_worker_domain_verification_is_separate": true,
    "independent_review_must_be_distinct_from_all_runtime_executors_and_verifier": true,
    "attested_execution_receipt_is_not_r2_pass": true
  },
  "loop_readiness_mapping": {
    "tool_execution_evidence": "runtime-binding:attested-execution-receipt+digital-worker:verified-evidence-intake",
    "loop_recovery_evidence": "digital-worker:team-run-state.blockers/recovery",
    "guardrail_coverage": "digital-worker:A0-A7+gate-policy",
    "budget_control_evidence": "digital-worker:context-and-action-scope",
    "handoff_or_delegation_evidence": "digital-worker:engineering-handoff+delivery-receipt",
    "termination_evidence": "runtime-binding:runtime-local-gates+digital-worker:completed/blocked/review-gate"
  },
