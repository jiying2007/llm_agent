{
  "schema": "reference-repository-lifecycle-policy/v1",
  "last_updated": "2026-09-19",
  "registration": {
    "schema": "reference-repository-registration-policy/v1",
    "status": "gated-registration",
    "default_mode": "dry-run",
    "candidate_schema": "external-practice-candidate/v1",
    "decision_schema": "external-practice-decision/v1",
    "required_gates": [
      "candidate_contract_gate",
      "owner_decision_gate",
      "repository_metadata_gate",
      "source_risk_gate",
      "analysis_report_gate",
      "duplicate_check_gate",
      "security_review_gate",
      "phase_gate",
      "registry_conflict_gate",
      "target_path_gate",
      "materialization_gate",
      "apply_workspace_gate",
      "rollback_plan_gate"
    ],
    "rules": {
      "apply_requires_explicit_flag": true,
      "apply_requires_owner_decision": true,
      "apply_requires_materialization_mode": true,
      "apply_requires_clean_workspace": true,
      "apply_requires_clean_source_origin_and_head": true,
      "apply_metadata_transaction_must_rollback": true,
      "apply_must_not_modify_agent_dev_kit": true,
      "apply_must_not_run_network_discovery": true,
      "apply_must_generate_rollback_evidence": true,
      "collector_or_curator_must_not_be_decision_owner": true,
      "legacy_candidate_schema_must_be_rejected": true,
      "reactivation_requires_disabled_registry_and_inactive_lifecycle": true
    }
  },
  "removal": {
    "schema": "reference-repository-removal-policy/v1",
    "status": "gated-removal",
    "default_mode": "dry-run",
    "required_gates": [
      "lifecycle_state_gate",
      "protected_repo_gate",
      "active_core_gate",
      "adoption_decision_gate",
      "evidence_dependency_gate",
      "dirty_baseline_gate",
      "rollback_plan_gate",
      "precheck_gate",
      "postcheck_gate"
    ],
    "eligible_lifecycle_states": [
      "archive-only",
      "disabled"
    ],
    "protected_repositories": [
      "agent-dev-kit"
    ],
    "blocked_lifecycle_states": [
      "active-core",
      "active-reference",
      "watch"
    ],
    "allowed_apply_targets": [
      ".gitmodules",
      "subrepos/registry.csv",
      "subrepos/dirty-baseline.tsv",
      "manifests/subrepo_lifecycle.json",
      "docs/llm-agent-maintenance-guide.md",
      "docs/runbooks/reference-repository-lifecycle.md",
      "reports/reference-repository-removal-*.json",
      "reports/reference-repository-removal-*.md"
    ],
    "rules": {
      "plan_requires_hashed_artifacts": true,
      "default_must_be_dry_run": true,
      "apply_requires_explicit_flag": true,
      "apply_requires_confirmed_plan": true,
      "apply_must_not_touch_agent_dev_kit": true,
      "apply_must_not_delete_without_rollback": true,
      "apply_must_run_precheck_and_postcheck": true,
      "dirty_baseline_update_must_be_explicit": true
    }
  }
}
