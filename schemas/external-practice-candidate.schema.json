{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-agent.local/schemas/external-practice-candidate.schema.json",
  "title": "external-practice-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "source_id",
    "provider",
    "source_type",
    "authority_level",
    "title",
    "canonical_url",
    "repository",
    "revision",
    "published_at",
    "last_activity_at",
    "retrieved_at",
    "review_after",
    "expires_at",
    "license",
    "topics",
    "summary",
    "content_sha256",
    "transport",
    "body_persisted",
    "trust_status",
    "review_status",
    "risk_flags",
    "evidence_refs",
    "asset_recommendation",
    "auto_actions"
  ],
  "properties": {
    "schema_version": {"const": "external-practice-candidate/v1"},
    "candidate_id": {"type": "string", "pattern": "^epc-[0-9a-f]{20}$"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "provider": {"enum": ["github", "gitlab", "gitee", "openai-official", "anthropic-official", "wechat", "manual"]},
    "source_type": {"enum": ["repository", "official-document", "wechat-article", "manual-reference"]},
    "authority_level": {"enum": ["official", "project", "community", "secondary", "manual"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "canonical_url": {"type": "string", "pattern": "^https://"},
    "repository": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["full_name", "host", "default_branch", "stars_count", "forks_count", "watchers_count", "archived", "language"],
          "properties": {
            "full_name": {"type": "string", "minLength": 3, "maxLength": 300},
            "host": {"enum": ["github.com", "gitlab.com", "gitee.com"]},
            "default_branch": {"type": ["string", "null"], "maxLength": 200},
            "stars_count": {"type": ["integer", "null"], "minimum": 0},
            "forks_count": {"type": ["integer", "null"], "minimum": 0},
            "watchers_count": {"type": ["integer", "null"], "minimum": 0},
            "archived": {"type": ["boolean", "null"]},
            "language": {"type": ["string", "null"], "maxLength": 100}
          }
        }
      ]
    },
    "revision": {"type": ["string", "null"], "maxLength": 200},
    "published_at": {"type": ["string", "null"], "format": "date"},
    "last_activity_at": {"type": ["string", "null"], "format": "date"},
    "retrieved_at": {"type": "string", "format": "date"},
    "review_after": {"type": "string", "format": "date"},
    "expires_at": {"type": ["string", "null"], "format": "date"},
    "license": {"type": "string", "minLength": 1, "maxLength": 160},
    "topics": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "summary": {"type": "string", "maxLength": 1000},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "transport": {"enum": ["metadata-only", "ledger-only"]},
    "body_persisted": {"const": false},
    "trust_status": {"enum": ["trusted-metadata", "unverified-metadata", "degraded"]},
    "review_status": {"const": "review-required"},
    "risk_flags": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "asset_recommendation": {"enum": ["agent", "skill", "workflow", "script", "manifest", "runbook", "observe"]},
    "auto_actions": {"type": "array", "maxItems": 0}
  }
}
