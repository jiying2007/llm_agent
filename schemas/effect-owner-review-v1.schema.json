{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-agent.local/schemas/effect-owner-review-v1.schema.json",
  "title": "llm-agent effect/value owner review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "decision",
    "owner",
    "reviewed_at",
    "evidence",
    "lifecycle_reviews",
    "rationale",
    "auto_apply",
    "release_authorized"
  ],
  "properties": {
    "schema": {
      "const": "llm-agent-effect-owner-review/v1"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "decision": {
      "enum": [
        "accept-evidence",
        "reject-evidence"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_input_sha256",
        "comparison_sha256",
        "measurement_sha256",
        "candidate_bundle_sha256"
      ],
      "properties": {
        "trial_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "comparison_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "measurement_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "lifecycle_reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_kind",
          "asset_id",
          "decision",
          "rationale"
        ],
        "properties": {
          "asset_kind": {
            "enum": [
              "agent",
              "skill",
              "profile"
            ]
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "decision": {
            "enum": [
              "retain",
              "consolidate-candidate",
              "retire-candidate",
              "observe"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000
    },
    "auto_apply": {
      "const": false
    },
    "release_authorized": {
      "const": false
    }
  }
}
