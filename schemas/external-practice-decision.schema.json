{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-agent.local/schemas/external-practice-decision.schema.json",
  "title": "external-practice-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "decision",
    "owner",
    "reviewed_at",
    "rationale",
    "target",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "external-practice-decision/v1"},
    "candidate_id": {"type": "string", "pattern": "^epc-[0-9a-f]{20}$"},
    "decision": {"enum": ["ADOPT", "MERGE", "ENHANCE", "OBSERVE", "REJECT"]},
    "owner": {"type": "string", "minLength": 2, "maxLength": 160},
    "reviewed_at": {"type": "string", "format": "date"},
    "rationale": {"type": "string", "minLength": 20, "maxLength": 2000},
    "target": {"type": "string", "minLength": 1, "maxLength": 300},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
