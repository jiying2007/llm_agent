{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-agent.local/schemas/external-practice-cycle-evidence.schema.json",
  "title": "external-practice-cycle-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "as_of", "status", "candidate_count", "deduplicated_count", "ledger_sha256", "jobs", "boundaries", "auto_actions"],
  "properties": {
    "schema": {"const": "external-practice-cycle-evidence/v1"},
    "mode": {"const": "report-only"},
    "as_of": {"type": "string", "format": "date"},
    "status": {"enum": ["complete", "degraded", "failed"]},
    "candidate_count": {"type": "integer", "minimum": 0, "maximum": 500},
    "deduplicated_count": {"type": "integer", "minimum": 0, "maximum": 500},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "transport", "mode", "request", "input_ref", "input_sha256", "status", "candidate_count", "deduplicated_count", "rate_limit", "duration_ms", "error_code"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
          "provider": {"enum": ["github", "gitlab", "gitee", "openai-official", "anthropic-official", "wechat", "manual"]},
          "transport": {"enum": ["metadata-only", "ledger-only"]},
          "mode": {"enum": ["fixture", "live", "local", "manual", "not-run"]},
          "request": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["host", "path", "query_sha256"],
                "properties": {
                  "host": {"enum": ["api.github.com", "gitlab.com", "gitee.com"]},
                  "path": {"type": "string", "pattern": "^/"},
                  "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
                }
              }
            ]
          },
          "input_ref": {"type": ["string", "null"], "maxLength": 500},
          "input_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["complete", "degraded-empty", "not-run-network-disabled", "failed"]},
          "candidate_count": {"type": "integer", "minimum": 0, "maximum": 100},
          "deduplicated_count": {"type": "integer", "minimum": 0, "maximum": 100},
          "rate_limit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "limit": {"type": "string", "pattern": "^[0-9]{1,20}$"},
              "remaining": {"type": "string", "pattern": "^[0-9]{1,20}$"},
              "reset": {"type": "string", "pattern": "^[0-9]{1,20}$"}
            }
          },
          "duration_ms": {"type": "integer", "minimum": 0},
          "error_code": {"type": ["string", "null"], "enum": ["intake-job-failed", null]}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_write", "external_code_executed", "repository_modified", "adk_modified", "live_runtime_modified", "credentials_persisted", "article_body_persisted", "decision_generated"],
      "properties": {
        "network_write": {"const": false},
        "external_code_executed": {"const": false},
        "repository_modified": {"const": false},
        "adk_modified": {"const": false},
        "live_runtime_modified": {"const": false},
        "credentials_persisted": {"const": false},
        "article_body_persisted": {"const": false},
        "decision_generated": {"const": false}
      }
    },
    "auto_actions": {"type": "array", "maxItems": 0}
  }
}
